// dav-3510 intra-kernel SIMD+SIMT implementation for cached fp16 RMSNorm.
//
// SIMD owns square reduction, sqrt/divide, normalization, and affine math.
// SIMT owns contiguous output staging over the normalized UB row.  A
// host-side selector still sends unsupported calls to the retained DPP/SIMT
// operator before this mixed kernel starts.

#include "acl/acl.h"
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#include <ascify/target/dav_c310/rowwise_simd_selectors_v1.hpp>

#include <cmath>
#include <cstdint>
#include <limits>

namespace ascify950_reg_rmsnorm {

static_assert(
    sizeof(half)
        == ascify::target::dav_c310::rowwise_simd_v1::kHalfStorageBytes,
    "runtime and selector must agree on fp16 storage width");

constexpr uint32_t kMaxColumns = 8192;
constexpr uint32_t kPipelineDepth = 1;
constexpr uint32_t kAdapterSimtThreads = 1024;
constexpr uint32_t kScalarSlotBytes = 32;
constexpr uint32_t kScalarSlotCount = 2;
constexpr uint32_t kRowBytes = kMaxColumns * sizeof(half);
constexpr uint32_t kConservativeUbBytes = 196608;
constexpr uint32_t kMaximumAffineUbBytes =
    2 * kPipelineDepth * kRowBytes + 2 * kRowBytes
    + kScalarSlotCount * kScalarSlotBytes;
constexpr int kDefaultAivCount = 56;

static_assert(kRowBytes == 16384, "unexpected maximum RMSNorm row size");
static_assert(kMaximumAffineUbBytes == 65600,
              "unexpected affine RMSNorm UB budget");
static_assert(kMaximumAffineUbBytes <= kConservativeUbBytes,
              "cached RMSNorm exceeds conservative UB budget");

__simd_vf__ inline void RmsSquareSumVF(
    __ubuf__ half* input, __ubuf__ float* sumSlot,
    uint32_t count, uint32_t chunkCount) {
  // Keep Reg traits inside SIMD code: ASC host/cube phases must not parse
  // Reg-only trait values at namespace scope.
  static constexpr AscendC::Reg::CastTrait kHalfToFloat = {
      AscendC::Reg::RegLayout::ZERO,
      AscendC::Reg::SatMode::UNKNOWN,
      AscendC::Reg::MaskMergeMode::ZEROING,
      AscendC::RoundMode::UNKNOWN};
  constexpr uint32_t kVectorLength =
      AscendC::VECTOR_REG_WIDTH / sizeof(float);

  AscendC::Reg::RegTensor<half> inputHalf;
  AscendC::Reg::RegTensor<float> inputFloat;
  AscendC::Reg::RegTensor<float> squareFloat;
  AscendC::Reg::RegTensor<float> squareSum;
  AscendC::Reg::MaskReg fullMask =
      AscendC::Reg::CreateMask<uint32_t,
                               AscendC::Reg::MaskPattern::ALL>();
  AscendC::Reg::MaskReg oneMask =
      AscendC::Reg::CreateMask<uint32_t,
                               AscendC::Reg::MaskPattern::VL1>();

  AscendC::Reg::Duplicate<float>(squareSum, 0.0F, fullMask);
  uint32_t remaining = count;
  for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
    const uint32_t offset = chunk * kVectorLength;
    AscendC::Reg::MaskReg tailMask =
        AscendC::Reg::UpdateMask<float>(remaining);
    AscendC::Reg::LoadAlign<
        half, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
        inputHalf, input + offset);
    AscendC::Reg::Cast<float, half, kHalfToFloat>(
        inputFloat, inputHalf, tailMask);
    AscendC::Reg::Mul<float>(
        squareFloat, inputFloat, inputFloat, tailMask);
    // Mul is zeroing for inactive tail lanes, so a full-mask accumulation
    // cannot add uninitialized data to the reduction.
    AscendC::Reg::Add<float>(
        squareSum, squareSum, squareFloat, fullMask);
  }

  AscendC::Reg::Reduce<AscendC::Reg::ReduceType::SUM>(
      squareSum, squareSum, fullMask);
  AscendC::Reg::StoreAlign<
      float, AscendC::Reg::StoreDist::DIST_FIRST_ELEMENT_B32>(
      sumSlot, squareSum, oneMask);
}

template <bool kAffine>
__simd_callee__ inline void RmsInverseNormalizeImpl(
    __ubuf__ half* output, __ubuf__ half* input, __ubuf__ half* weight,
    __ubuf__ float* sumSlot, __ubuf__ float* inverseSlot,
    uint32_t count, uint32_t chunkCount,
    float inverseColumns, float epsilon) {
  static constexpr AscendC::Reg::CastTrait kHalfToFloat = {
      AscendC::Reg::RegLayout::ZERO,
      AscendC::Reg::SatMode::UNKNOWN,
      AscendC::Reg::MaskMergeMode::ZEROING,
      AscendC::RoundMode::UNKNOWN};
  static constexpr AscendC::Reg::CastTrait kFloatToHalf = {
      AscendC::Reg::RegLayout::ZERO,
      AscendC::Reg::SatMode::NO_SAT,
      AscendC::Reg::MaskMergeMode::ZEROING,
      AscendC::RoundMode::CAST_RINT};
  constexpr uint32_t kVectorLength =
      AscendC::VECTOR_REG_WIDTH / sizeof(float);

  AscendC::Reg::RegTensor<half> inputHalf;
  AscendC::Reg::RegTensor<half> weightHalf;
  AscendC::Reg::RegTensor<half> roundedNormalizedHalf;
  AscendC::Reg::RegTensor<half> outputHalf;
  AscendC::Reg::RegTensor<float> inputFloat;
  AscendC::Reg::RegTensor<float> meanSquare;
  AscendC::Reg::RegTensor<float> rootMeanSquare;
  AscendC::Reg::RegTensor<float> oneFloat;
  AscendC::Reg::RegTensor<float> inverseRms;
  AscendC::Reg::RegTensor<float> normalizedFloat;
  AscendC::Reg::MaskReg fullMask =
      AscendC::Reg::CreateMask<uint32_t,
                               AscendC::Reg::MaskPattern::ALL>();
  AscendC::Reg::MaskReg oneMask =
      AscendC::Reg::CreateMask<uint32_t,
                               AscendC::Reg::MaskPattern::VL1>();

  AscendC::Reg::LoadAlign<
      float, AscendC::Reg::LoadDist::DIST_BRC_B32>(
      meanSquare, sumSlot);
  AscendC::Reg::Muls<float>(
      meanSquare, meanSquare, inverseColumns, fullMask);
  AscendC::Reg::Adds<float>(
      meanSquare, meanSquare, epsilon, fullMask);

  // beta3 has no public register-level reciprocal-square-root primitive.  Use
  // only public Reg operations; the LocalTensor lowering uses the same default
  // Sqrt+Div sequence for non-negative inputs.
  AscendC::Reg::Sqrt<float>(
      rootMeanSquare, meanSquare, fullMask);
  AscendC::Reg::Duplicate<float>(oneFloat, 1.0F, fullMask);
  AscendC::Reg::Div<float>(
      inverseRms, oneFloat, rootMeanSquare, fullMask);
  AscendC::Reg::StoreAlign<
      float, AscendC::Reg::StoreDist::DIST_FIRST_ELEMENT_B32>(
      inverseSlot, inverseRms, oneMask);

  uint32_t remaining = count;
  for (uint32_t chunk = 0; chunk < chunkCount; ++chunk) {
    const uint32_t offset = chunk * kVectorLength;
    AscendC::Reg::MaskReg tailMask =
        AscendC::Reg::UpdateMask<float>(remaining);
    AscendC::Reg::LoadAlign<
        half, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
        inputHalf, input + offset);
    AscendC::Reg::Cast<float, half, kHalfToFloat>(
        inputFloat, inputHalf, tailMask);
    AscendC::Reg::Mul<float>(
        normalizedFloat, inputFloat, inverseRms, tailMask);

    if constexpr (kAffine) {
      // The existing operator rounds x*inverse_rms to fp16 before applying
      // fp16 weight.  Keeping the multiply in half preserves that two-step
      // rounding contract instead of fusing gamma into the FP32 expression.
      AscendC::Reg::Cast<half, float, kFloatToHalf>(
          roundedNormalizedHalf, normalizedFloat, tailMask);
      AscendC::Reg::LoadAlign<
          half, AscendC::Reg::LoadDist::DIST_UNPACK_B16>(
          weightHalf, weight + offset);
      AscendC::Reg::Mul<half>(
          outputHalf, roundedNormalizedHalf, weightHalf, tailMask);
    } else {
      AscendC::Reg::Cast<half, float, kFloatToHalf>(
          outputHalf, normalizedFloat, tailMask);
    }

    AscendC::Reg::StoreAlign<
        half, AscendC::Reg::StoreDist::DIST_PACK_B32>(
        output + offset, outputHalf, tailMask);
  }
}

__simd_vf__ inline void RmsInverseNormalizePlainVF(
    __ubuf__ half* output, __ubuf__ half* input,
    __ubuf__ float* sumSlot, __ubuf__ float* inverseSlot,
    uint32_t count, uint32_t chunkCount,
    float inverseColumns, float epsilon) {
  RmsInverseNormalizeImpl<false>(
      output, input, input, sumSlot, inverseSlot, count, chunkCount,
      inverseColumns, epsilon);
}

__simd_vf__ inline void RmsInverseNormalizeAffineVF(
    __ubuf__ half* output, __ubuf__ half* input, __ubuf__ half* weight,
    __ubuf__ float* sumSlot, __ubuf__ float* inverseSlot,
    uint32_t count, uint32_t chunkCount,
    float inverseColumns, float epsilon) {
  RmsInverseNormalizeImpl<true>(
      output, input, weight, sumSlot, inverseSlot, count, chunkCount,
      inverseColumns, epsilon);
}

__simt_vf__ __aicore__ LAUNCH_BOUND(kAdapterSimtThreads) inline void
RmsStoreAdapterSimtVF(
    __ubuf__ half* output, __ubuf__ half* normalized, uint32_t count) {
  for (uint32_t index = static_cast<uint32_t>(threadIdx.x); index < count;
       index += static_cast<uint32_t>(blockDim.x)) {
    output[index] = normalized[index];
  }
}

__aicore__ inline uint32_t ChunkCount(uint32_t count) {
  constexpr uint32_t kVectorLength =
      AscendC::VECTOR_REG_WIDTH / sizeof(float);
  return (count + kVectorLength - 1) / kVectorLength;
}

__aicore__ inline void ComputeSquareSum(
    const AscendC::LocalTensor<half>& input,
    const AscendC::LocalTensor<float>& scalarSlots, uint32_t count) {
  asc_vf_call<RmsSquareSumVF>(
      (__ubuf__ half*)input.GetPhyAddr(),
      (__ubuf__ float*)scalarSlots.GetPhyAddr(), count, ChunkCount(count));
}

template <bool kAffine>
__aicore__ inline void ComputeInverseNormalize(
    const AscendC::LocalTensor<half>& output,
    const AscendC::LocalTensor<half>& input,
    const AscendC::LocalTensor<half>& weight,
    const AscendC::LocalTensor<float>& sumSlot,
    const AscendC::LocalTensor<float>& inverseSlot, uint32_t count,
    float inverseColumns, float epsilon) {
  if constexpr (kAffine) {
    asc_vf_call<RmsInverseNormalizeAffineVF>(
        (__ubuf__ half*)output.GetPhyAddr(),
        (__ubuf__ half*)input.GetPhyAddr(),
        (__ubuf__ half*)weight.GetPhyAddr(),
        (__ubuf__ float*)sumSlot.GetPhyAddr(),
        (__ubuf__ float*)inverseSlot.GetPhyAddr(), count, ChunkCount(count),
        inverseColumns, epsilon);
  } else {
    asc_vf_call<RmsInverseNormalizePlainVF>(
        (__ubuf__ half*)output.GetPhyAddr(),
        (__ubuf__ half*)input.GetPhyAddr(),
        (__ubuf__ float*)sumSlot.GetPhyAddr(),
        (__ubuf__ float*)inverseSlot.GetPhyAddr(), count, ChunkCount(count),
        inverseColumns, epsilon);
  }
}

__aicore__ inline void ApplyStoreAdapterSimt(
    const AscendC::LocalTensor<half>& output,
    const AscendC::LocalTensor<half>& normalized, uint32_t count) {
  asc_vf_call<RmsStoreAdapterSimtVF>(
      dim3(kAdapterSimtThreads),
      (__ubuf__ half*)output.GetPhyAddr(),
      (__ubuf__ half*)normalized.GetPhyAddr(), count);
}

template <bool kAffine>
class RmsNormRegCachedKernel {
 public:
  __aicore__ inline void Init(
      GM_ADDR input, GM_ADDR output, GM_ADDR weight, GM_ADDR inverseRms,
      int64_t rows, uint32_t columns, float inverseColumns, float epsilon) {
    inputGm_.SetGlobalBuffer((__gm__ half*)input);
    outputGm_.SetGlobalBuffer((__gm__ half*)output);
    inverseRmsGm_.SetGlobalBuffer((__gm__ float*)inverseRms);
    if constexpr (kAffine) {
      weightGm_.SetGlobalBuffer((__gm__ half*)weight);
      pipe_.InitBuffer(weightQueue_, kPipelineDepth, kRowBytes);
    }
    pipe_.InitBuffer(inputQueue_, kPipelineDepth, kRowBytes);
    pipe_.InitBuffer(outputQueue_, kPipelineDepth, kRowBytes);
    pipe_.InitBuffer(normalizedBuffer_, kRowBytes);
    pipe_.InitBuffer(inverseQueue_, kPipelineDepth, kScalarSlotBytes);
    pipe_.InitBuffer(sumBuffer_, kScalarSlotBytes);
    rows_ = rows;
    columns_ = columns;
    inverseColumns_ = inverseColumns;
    epsilon_ = epsilon;
  }

  __aicore__ inline void Process() {
    AscendC::LocalTensor<half> weightLocal;
    if constexpr (kAffine) {
      weightLocal = weightQueue_.AllocTensor<half>();
      CopyIntoLocal(weightLocal, weightGm_, columns_);
      weightQueue_.EnQue(weightLocal);
      weightLocal = weightQueue_.DeQue<half>();
    }

    const int64_t firstRow = static_cast<int64_t>(AscendC::GetBlockIdx());
    const int64_t rowStride = static_cast<int64_t>(AscendC::GetBlockNum());
    for (int64_t row = firstRow; row < rows_; row += rowStride) {
      ProcessRow(row, weightLocal);
    }

    if constexpr (kAffine) {
      weightQueue_.FreeTensor(weightLocal);
    }
  }

 private:
  __aicore__ inline int64_t RowOffset(int64_t row) const {
    return row * static_cast<int64_t>(columns_);
  }

  __aicore__ inline void CopyIntoLocal(
      const AscendC::LocalTensor<half>& local,
      const AscendC::GlobalTensor<half>& global, uint32_t count) {
    AscendC::DataCopyExtParams params{
        1, static_cast<uint32_t>(count * sizeof(half)), 0, 0, 0};
    AscendC::DataCopyPadExtParams<half> pad{false, 0, 0, 0};
    AscendC::DataCopyPad(local, global, params, pad);
  }

  __aicore__ inline void ProcessRow(
      int64_t row, const AscendC::LocalTensor<half>& weightLocal) {
    const int64_t rowOffset = RowOffset(row);
    AscendC::LocalTensor<half> inputLocal =
        inputQueue_.AllocTensor<half>();
    CopyIntoLocal(inputLocal, inputGm_[rowOffset], columns_);
    inputQueue_.EnQue(inputLocal);
    inputLocal = inputQueue_.DeQue<half>();

    AscendC::LocalTensor<half> outputLocal =
        outputQueue_.AllocTensor<half>();
    AscendC::LocalTensor<half> normalizedLocal =
        normalizedBuffer_.Get<half>();
    AscendC::LocalTensor<float> inverseLocal =
        inverseQueue_.AllocTensor<float>();
    AscendC::LocalTensor<float> sumLocal = sumBuffer_.Get<float>();
    ComputeSquareSum(inputLocal, sumLocal, columns_);
    AscendC::PipeBarrier<PIPE_V>();
    ComputeInverseNormalize<kAffine>(
        normalizedLocal, inputLocal, weightLocal, sumLocal, inverseLocal,
        columns_, inverseColumns_, epsilon_);
    AscendC::PipeBarrier<PIPE_V>();
    ApplyStoreAdapterSimt(outputLocal, normalizedLocal, columns_);

    inputQueue_.FreeTensor(inputLocal);
    outputQueue_.EnQue(outputLocal);
    inverseQueue_.EnQue(inverseLocal);

    // Keep the inverse on the vector-to-MTE3 queue.  Reading the Reg-written
    // UB slot through scalar GetValue and then issuing a scalar GM SetValue is
    // not a valid cross-pipeline handoff on dav-3510.  DataCopyPad supports an
    // exact 4-byte GM write, while the 32-byte queue slot supplies the source
    // alignment and the queue supplies the V<->MTE3 event ordering.
    inverseLocal = inverseQueue_.DeQue<float>();
    AscendC::DataCopyExtParams inverseCopy{
        1, static_cast<uint32_t>(sizeof(float)), 0, 0, 0};
    AscendC::DataCopyPad(
        inverseRmsGm_[static_cast<uint64_t>(row)], inverseLocal,
        inverseCopy);
    inverseQueue_.FreeTensor(inverseLocal);

    outputLocal = outputQueue_.DeQue<half>();
    AscendC::DataCopyExtParams copyOut{
        1, static_cast<uint32_t>(columns_ * sizeof(half)), 0, 0, 0};
    AscendC::DataCopyPad(outputGm_[rowOffset], outputLocal, copyOut);
    outputQueue_.FreeTensor(outputLocal);
  }

  AscendC::TPipe pipe_;
  AscendC::GlobalTensor<half> inputGm_;
  AscendC::GlobalTensor<half> outputGm_;
  AscendC::GlobalTensor<half> weightGm_;
  AscendC::GlobalTensor<float> inverseRmsGm_;
  AscendC::TQue<AscendC::TPosition::VECIN, kPipelineDepth> inputQueue_;
  AscendC::TQue<AscendC::TPosition::VECOUT, kPipelineDepth> outputQueue_;
  AscendC::TQue<AscendC::TPosition::VECOUT, kPipelineDepth> inverseQueue_;
  AscendC::TQue<AscendC::TPosition::VECIN, kPipelineDepth> weightQueue_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> normalizedBuffer_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> sumBuffer_;
  int64_t rows_ = 0;
  uint32_t columns_ = 0;
  float inverseColumns_ = 0.0F;
  float epsilon_ = 0.0F;
};

extern "C" __global__ __aicore__ void rmsnorm_reg_cached_plain_kernel(
    GM_ADDR input, GM_ADDR output, GM_ADDR inverseRms, int64_t rows,
    uint32_t columns, float inverseColumns, float epsilon) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  RmsNormRegCachedKernel<false> kernel;
  kernel.Init(
      input, output, input, inverseRms, rows, columns, inverseColumns,
      epsilon);
  kernel.Process();
}

extern "C" __global__ __aicore__ void rmsnorm_reg_cached_affine_kernel(
    GM_ADDR input, GM_ADDR output, GM_ADDR weight, GM_ADDR inverseRms,
    int64_t rows, uint32_t columns, float inverseColumns, float epsilon) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  RmsNormRegCachedKernel<true> kernel;
  kernel.Init(
      input, output, weight, inverseRms, rows, columns, inverseColumns,
      epsilon);
  kernel.Process();
}

inline bool IsAligned16(const void* pointer) {
  return (reinterpret_cast<uintptr_t>(pointer) & 15U) == 0;
}

inline bool IsAligned4(const void* pointer) {
  return (reinterpret_cast<uintptr_t>(pointer) & 3U) == 0;
}

extern "C" aclError ascify950_rmsnorm_reg_cached_launch_v1(
    aclrtStream stream, const half* input, half* output, const half* weight,
    float* inverseRms, int64_t rows, int64_t columns, double epsilon) {
  if (!ascify::target::dav_c310::rowwise_simd_v1::
          IsRmsNormCachedSimdDomain(
              stream, input, output, weight, inverseRms, rows, columns,
              epsilon, 0, 0)) {
    return ACL_ERROR_RT_PARAM_INVALID;
  }
  if (stream == nullptr || input == nullptr || output == nullptr
      || inverseRms == nullptr || rows <= 0 || columns <= 0
      || columns > static_cast<int64_t>(kMaxColumns)
      || columns % 8 != 0
      || rows > std::numeric_limits<int64_t>::max() / columns
      || !(epsilon > 0.0) || !std::isfinite(epsilon)
      || !IsAligned16(input) || !IsAligned16(output)
      || !IsAligned4(inverseRms)
      || (weight != nullptr && !IsAligned16(weight))) {
    return ACL_ERROR_RT_PARAM_INVALID;
  }

  const uint32_t narrowColumns = static_cast<uint32_t>(columns);
  const float inverseColumns = 1.0F / static_cast<float>(narrowColumns);
  const float narrowEpsilon = static_cast<float>(epsilon);
  if (!(narrowEpsilon > 0.0F) || !std::isfinite(narrowEpsilon)) {
    return ACL_ERROR_RT_PARAM_INVALID;
  }
  const int gridBlocks = static_cast<int>(
      rows < kDefaultAivCount ? rows : kDefaultAivCount);
  if (weight != nullptr) {
    rmsnorm_reg_cached_affine_kernel
        <<<gridBlocks, kMaximumAffineUbBytes, stream>>>(
            (GM_ADDR)input, (GM_ADDR)output, (GM_ADDR)weight,
            (GM_ADDR)inverseRms, rows, narrowColumns, inverseColumns,
            narrowEpsilon);
  } else {
    rmsnorm_reg_cached_plain_kernel
        <<<gridBlocks, kMaximumAffineUbBytes, stream>>>(
            (GM_ADDR)input, (GM_ADDR)output, (GM_ADDR)inverseRms, rows,
            narrowColumns, inverseColumns, narrowEpsilon);
  }
  return aclrtPeekAtLastError(static_cast<aclrtLastErrLevel>(0));
}

}  // namespace ascify950_reg_rmsnorm
