#ifdef ASCIFY950_USE_TUNED_RMSNORM
#include "kernels/rmsnorm_native_kernel.cce"
#endif
#include "oneflow/core/cuda/rms_norm.cuh"
#include "ascify950/rmsnorm_affine_store.cuh"
#include "common/runner_common.hpp"

#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <limits>
#include <sstream>
#include <string>
#include <vector>

#ifndef ASCIFY950_MATH_MODE
#define ASCIFY950_MATH_MODE "unspecified"
#endif

namespace ln = oneflow::cuda::layer_norm;
namespace rn = oneflow::cuda::rms_norm;
namespace b950 = ascify950;

constexpr size_t kGuardBytes = 256;
constexpr uint8_t kCanaryByte = 0xd3;
constexpr uint8_t kPayloadCanaryByte = 0xff;

class GuardedBuffer {
 public:
  aclError Allocate(size_t payload_bytes) {
    if (payload_bytes > std::numeric_limits<size_t>::max() - 2 * kGuardBytes) {
      return ACL_ERROR_RT_PARAM_INVALID;
    }
    payload_bytes_ = payload_bytes;
    return storage_.Allocate(payload_bytes_ + 2 * kGuardBytes);
  }

  aclError Fill(uint8_t value) {
    return aclrtMemset(storage_.Get(), storage_.Bytes(), static_cast<int32_t>(value),
                       storage_.Bytes());
  }

  aclError FillPayload(uint8_t value) {
    return aclrtMemset(Payload(), payload_bytes_, static_cast<int32_t>(value), payload_bytes_);
  }

  aclError CopyPayloadFromHost(const void* source) {
    return aclrtMemcpy(Payload(), payload_bytes_, source, payload_bytes_,
                       ACL_MEMCPY_HOST_TO_DEVICE);
  }

  aclError CopyPayloadToHost(void* destination) {
    return aclrtMemcpy(destination, payload_bytes_, Payload(), payload_bytes_,
                       ACL_MEMCPY_DEVICE_TO_HOST);
  }

  aclError CountGuardMismatches(uint8_t expected, uint64_t* mismatch_count) {
    std::vector<uint8_t> prefix(kGuardBytes);
    std::vector<uint8_t> suffix(kGuardBytes);
    aclError error =
        aclrtMemcpy(prefix.data(), prefix.size(), storage_.Get(), kGuardBytes,
                    ACL_MEMCPY_DEVICE_TO_HOST);
    if (error == ACL_SUCCESS) {
      error = aclrtMemcpy(suffix.data(), suffix.size(), Suffix(), kGuardBytes,
                          ACL_MEMCPY_DEVICE_TO_HOST);
    }
    if (error != ACL_SUCCESS) { return error; }
    for (uint8_t value : prefix) {
      if (value != expected) { ++*mismatch_count; }
    }
    for (uint8_t value : suffix) {
      if (value != expected) { ++*mismatch_count; }
    }
    return ACL_SUCCESS;
  }

  template<typename T>
  T* As() {
    return static_cast<T*>(Payload());
  }

 private:
  void* Payload() {
    return static_cast<void*>(static_cast<uint8_t*>(storage_.Get()) + kGuardBytes);
  }

  void* Suffix() {
    return static_cast<void*>(static_cast<uint8_t*>(storage_.Get()) + kGuardBytes
                              + payload_bytes_);
  }

  b950::DeviceBuffer storage_;
  size_t payload_bytes_ = 0;
};

static aclError LaunchRmsNorm(aclrtStream stream, const half* input, half* output,
                              const half* weight, float* inv_rms, int64_t rows, int64_t cols,
                              double eps, bool affine) {
#ifdef ASCIFY950_USE_TUNED_RMSNORM
  return ascify950::native_rmsnorm::Launch(
      stream, input, output, affine ? weight : nullptr, inv_rms, rows, cols, eps);
#else
  ln::DirectLoad<half, float> load(input, cols);
  if (affine) {
    ascify950_recipe_fixture::RmsNormAffineStore<float, half, true> store(
        output, weight, static_cast<int32_t>(cols));
    return rn::LaunchRmsNorm<decltype(load), decltype(store), float>(
        stream, load, store, rows, cols, eps, inv_rms);
  }
  ascify950_recipe_fixture::RmsNormAffineStore<float, half, false> store(
      output, nullptr, static_cast<int32_t>(cols));
  return rn::LaunchRmsNorm<decltype(load), decltype(store), float>(
      stream, load, store, rows, cols, eps, inv_rms);
#endif
}

static uint64_t CountByteMismatches(const void* lhs, const void* rhs, size_t bytes) {
  const auto* left = static_cast<const uint8_t*>(lhs);
  const auto* right = static_cast<const uint8_t*>(rhs);
  uint64_t mismatches = 0;
  for (size_t i = 0; i < bytes; ++i) {
    if (left[i] != right[i]) { ++mismatches; }
  }
  return mismatches;
}

int main(int argc, char** argv) {
  const std::string shapes_path =
      b950::GetArg(argc, argv, "--shapes", "shapes/correctness.csv");
  const std::string output_path =
      b950::GetArg(argc, argv, "--out", "accuracy_history.csv");
  const std::string run_id = b950::GetArg(argc, argv, "--run-id", "manual");
  const std::string requested_tier = b950::GetArg(argc, argv, "--tier", "smoke");
  const int device_id = std::atoi(b950::GetArg(argc, argv, "--device", "0"));
  const uint64_t seed =
      std::strtoull(b950::GetArg(argc, argv, "--seed", "0x9507a45"), nullptr, 0);
  const size_t max_elements = static_cast<size_t>(
      std::strtoull(b950::GetArg(argc, argv, "--max-elements", "4000000"), nullptr, 10));
  const double abs_tolerance =
      std::strtod(b950::GetArg(argc, argv, "--abs-tol", "5e-3"), nullptr);
  const double scaled_rel_tolerance =
      std::strtod(b950::GetArg(argc, argv, "--scaled-rel-tol", "5e-3"), nullptr);
  const double inv_abs_tolerance =
      std::strtod(b950::GetArg(argc, argv, "--inv-abs-tol", "2e-3"), nullptr);
  const double inv_scaled_rel_tolerance =
      std::strtod(b950::GetArg(argc, argv, "--inv-scaled-rel-tol", "5e-3"), nullptr);

  const std::vector<b950::Case> cases = b950::ReadCases(shapes_path);
  b950::AccuracyCsvWriter csv(output_path);
  b950::AclSession session;
  const aclError init_error = session.Init(device_id);
  if (init_error != ACL_SUCCESS) {
    std::fprintf(stderr, "%s\n",
                 b950::AclErrorReason("ACL session initialization", init_error).c_str());
    return 1;
  }

  int selected = 0;
  int passed = 0;
  int failed = 0;
  int skipped = 0;
  for (const b950::Case& test_case : cases) {
    if (test_case.op != "rms_norm" || test_case.dtype != "fp16" || !test_case.run_check
        || !b950::TierEnabled(test_case.tier, requested_tier)) {
      continue;
    }
    ++selected;
    b950::AccuracyRecord record;
    record.run_id = run_id;
    record.op = "rms_norm";
    record.dtype = "fp16";
    record.math_mode = ASCIFY950_MATH_MODE;
#ifdef ASCIFY950_USE_TUNED_RMSNORM
    record.variant = test_case.affine ? "native_affine" : "native_plain";
#else
    record.variant = test_case.affine ? "converted_affine" : "converted_plain";
#endif
    record.test_case = test_case;
    record.device_id = device_id;

    size_t elements = 0;
    size_t tensor_bytes = 0;
    size_t weight_elements = 0;
    size_t weight_bytes = 0;
    size_t inv_elements = 0;
    size_t inv_bytes = 0;
    std::string size_reason;
    bool size_ok =
        b950::CheckedTensorSize(test_case.rows, test_case.cols, sizeof(uint16_t), &elements,
                                &tensor_bytes, &size_reason);
    if (size_ok) {
      size_ok = b950::CheckedTensorSize(1, test_case.cols, sizeof(uint16_t), &weight_elements,
                                        &weight_bytes, &size_reason);
    }
    if (size_ok) {
      size_ok = b950::CheckedTensorSize(test_case.rows, 1, sizeof(float), &inv_elements,
                                        &inv_bytes, &size_reason);
    }
    if (!size_ok || test_case.rows > std::numeric_limits<int>::max()
        || test_case.cols > std::numeric_limits<int>::max()) {
      record.status = "error";
      record.reason = size_ok ? "rows or cols exceed the kernel int32 launch domain" : size_reason;
      csv.Write(record);
      ++failed;
      continue;
    }
    if (elements > max_elements) {
      record.status = "skip";
      record.reason = "correctness case exceeds --max-elements";
      csv.Write(record);
      ++skipped;
      continue;
    }
    if (!(test_case.eps > 0.0) || !std::isfinite(test_case.eps)) {
      record.status = "error";
      record.reason = "eps must be positive and finite";
      csv.Write(record);
      ++failed;
      continue;
    }

    const b950::InputPatternCode pattern = b950::PatternCode(test_case.input_pattern);
    const uint64_t case_seed = seed ^ static_cast<uint64_t>(test_case.idx + 1);
    std::vector<uint16_t> host_input(elements);
    std::vector<uint16_t> host_input_after(elements);
    std::vector<float> quantized_input(elements);
    for (size_t linear = 0; linear < elements; ++linear) {
      const int64_t row = static_cast<int64_t>(linear / static_cast<size_t>(test_case.cols));
      const int64_t col =
          static_cast<int64_t>(linear - static_cast<size_t>(row) * test_case.cols);
      const float value =
          b950::HostInputValue(pattern, linear, row, col, test_case.cols, case_seed);
      host_input[linear] = b950::FloatToHalfBits(value);
      quantized_input[linear] = b950::HalfBitsToFloat(host_input[linear]);
    }

    std::vector<uint16_t> host_weight(weight_elements);
    std::vector<uint16_t> host_weight_after(weight_elements);
    std::vector<float> quantized_weight(weight_elements);
    for (size_t col = 0; col < weight_elements; ++col) {
      const uint64_t hash = b950::SplitMix64Host(case_seed ^ 0x55aa55aaULL ^ col);
      const float unit =
          static_cast<float>(hash & 0x00ffffffULL) * (1.0f / 16777215.0f);
      host_weight[col] = b950::FloatToHalfBits(0.5f + unit);
      quantized_weight[col] = b950::HalfBitsToFloat(host_weight[col]);
    }

    GuardedBuffer device_input;
    GuardedBuffer device_output;
    GuardedBuffer device_inv_rms;
    GuardedBuffer device_weight;
    aclError error = device_input.Allocate(tensor_bytes);
    if (error == ACL_SUCCESS) { error = device_output.Allocate(tensor_bytes); }
    if (error == ACL_SUCCESS) { error = device_inv_rms.Allocate(inv_bytes); }
    if (error == ACL_SUCCESS && test_case.affine) {
      error = device_weight.Allocate(weight_bytes);
    }
    if (error != ACL_SUCCESS) {
      record.status = "error";
      record.reason = b950::AclErrorReason("guarded aclrtMalloc", error);
      csv.Write(record);
      ++failed;
      continue;
    }

    error = device_input.Fill(kCanaryByte);
    if (error == ACL_SUCCESS) { error = device_output.Fill(kCanaryByte); }
    if (error == ACL_SUCCESS) { error = device_inv_rms.Fill(kCanaryByte); }
    if (error == ACL_SUCCESS && test_case.affine) {
      error = device_weight.Fill(kCanaryByte);
    }
    if (error == ACL_SUCCESS) { error = device_output.FillPayload(kPayloadCanaryByte); }
    if (error == ACL_SUCCESS) { error = device_inv_rms.FillPayload(kPayloadCanaryByte); }
    if (error == ACL_SUCCESS) { error = device_input.CopyPayloadFromHost(host_input.data()); }
    if (error == ACL_SUCCESS && test_case.affine) {
      error = device_weight.CopyPayloadFromHost(host_weight.data());
    }
    if (error != ACL_SUCCESS) {
      record.status = "error";
      record.reason = b950::AclErrorReason("guard/canary initialization", error);
      csv.Write(record);
      ++failed;
      continue;
    }

    error = LaunchRmsNorm(
        session.Stream(), device_input.As<const half>(), device_output.As<half>(),
        test_case.affine ? device_weight.As<const half>() : nullptr,
        device_inv_rms.As<float>(), test_case.rows, test_case.cols, test_case.eps,
        test_case.affine);
    if (error == ACL_SUCCESS) { error = aclrtSynchronizeStream(session.Stream()); }
    if (error != ACL_SUCCESS) {
      record.status = "error";
      record.reason = b950::AclErrorReason("rms_norm launch or synchronize", error);
      csv.Write(record);
      ++failed;
      continue;
    }

    std::vector<uint16_t> host_output(elements);
    std::vector<float> host_inv_rms(inv_elements);
    error = device_output.CopyPayloadToHost(host_output.data());
    if (error == ACL_SUCCESS) { error = device_inv_rms.CopyPayloadToHost(host_inv_rms.data()); }
    if (error == ACL_SUCCESS) { error = device_input.CopyPayloadToHost(host_input_after.data()); }
    if (error == ACL_SUCCESS && test_case.affine) {
      error = device_weight.CopyPayloadToHost(host_weight_after.data());
    }

    uint64_t guard_mismatches = 0;
    if (error == ACL_SUCCESS) {
      error = device_input.CountGuardMismatches(kCanaryByte, &guard_mismatches);
    }
    if (error == ACL_SUCCESS) {
      error = device_output.CountGuardMismatches(kCanaryByte, &guard_mismatches);
    }
    if (error == ACL_SUCCESS) {
      error = device_inv_rms.CountGuardMismatches(kCanaryByte, &guard_mismatches);
    }
    if (error == ACL_SUCCESS && test_case.affine) {
      error = device_weight.CountGuardMismatches(kCanaryByte, &guard_mismatches);
    }
    if (error != ACL_SUCCESS) {
      record.status = "error";
      record.reason = b950::AclErrorReason("guard/payload copy", error);
      csv.Write(record);
      ++failed;
      continue;
    }

    uint64_t canary_mismatches =
        CountByteMismatches(host_input.data(), host_input_after.data(), tensor_bytes);
    if (test_case.affine) {
      canary_mismatches +=
          CountByteMismatches(host_weight.data(), host_weight_after.data(), weight_bytes);
    }
    constexpr uint16_t output_canary =
        static_cast<uint16_t>(kPayloadCanaryByte)
        | (static_cast<uint16_t>(kPayloadCanaryByte) << 8);
    constexpr uint32_t inv_canary =
        static_cast<uint32_t>(kPayloadCanaryByte)
        | (static_cast<uint32_t>(kPayloadCanaryByte) << 8)
        | (static_cast<uint32_t>(kPayloadCanaryByte) << 16)
        | (static_cast<uint32_t>(kPayloadCanaryByte) << 24);
    for (uint16_t value : host_output) {
      if (value == output_canary) { ++canary_mismatches; }
    }
    for (float value : host_inv_rms) {
      uint32_t bits = 0;
      std::memcpy(&bits, &value, sizeof(bits));
      if (bits == inv_canary) { ++canary_mismatches; }
    }

    double max_abs_error = 0.0;
    double max_scaled_rel_error = 0.0;
    double max_inv_abs_error = 0.0;
    double max_inv_scaled_rel_error = 0.0;
    uint64_t nonfinite_count = 0;
    const float eps = static_cast<float>(test_case.eps);
    for (int64_t row = 0; row < test_case.rows; ++row) {
      const size_t row_offset = static_cast<size_t>(row) * test_case.cols;
      float square_sum = 0.0f;
      for (int64_t col = 0; col < test_case.cols; ++col) {
        const float value = quantized_input[row_offset + col];
        square_sum += value * value;
      }
      const float reference_inv_rms =
          1.0f / std::sqrt(square_sum / static_cast<float>(test_case.cols) + eps);
      const float actual_inv_rms = host_inv_rms[static_cast<size_t>(row)];
      if (!std::isfinite(actual_inv_rms)) {
        ++nonfinite_count;
      } else {
        const double absolute_error =
            std::fabs(static_cast<double>(actual_inv_rms)
                      - static_cast<double>(reference_inv_rms));
        const double scaled_relative_error =
            absolute_error / std::max(std::fabs(static_cast<double>(reference_inv_rms)), 1.0e-3);
        max_inv_abs_error = std::max(max_inv_abs_error, absolute_error);
        max_inv_scaled_rel_error =
            std::max(max_inv_scaled_rel_error, scaled_relative_error);
      }

      for (int64_t col = 0; col < test_case.cols; ++col) {
        float reference = quantized_input[row_offset + col] * reference_inv_rms;
        if (test_case.affine) {
          const float normalized_half =
              b950::HalfBitsToFloat(b950::FloatToHalfBits(reference));
          reference = normalized_half * quantized_weight[static_cast<size_t>(col)];
        }
        reference = b950::HalfBitsToFloat(b950::FloatToHalfBits(reference));
        const double actual = b950::HalfBitsToFloat(host_output[row_offset + col]);
        if (!std::isfinite(actual)) {
          ++nonfinite_count;
          continue;
        }
        const double absolute_error = std::fabs(actual - static_cast<double>(reference));
        const double scaled_relative_error =
            absolute_error / std::max(std::fabs(static_cast<double>(reference)), 1.0e-3);
        max_abs_error = std::max(max_abs_error, absolute_error);
        max_scaled_rel_error = std::max(max_scaled_rel_error, scaled_relative_error);
      }
    }

    record.max_abs_error = max_abs_error;
    record.max_scaled_rel_error = max_scaled_rel_error;
    record.max_aux_abs_error = max_inv_abs_error;
    record.max_aux_scaled_rel_error = max_inv_scaled_rel_error;
    record.nonfinite_count = nonfinite_count;
    record.guard_mismatch_count = guard_mismatches;
    record.canary_mismatch_count = canary_mismatches;
    if (max_abs_error <= abs_tolerance
        && max_scaled_rel_error <= scaled_rel_tolerance
        && max_inv_abs_error <= inv_abs_tolerance
        && max_inv_scaled_rel_error <= inv_scaled_rel_tolerance && nonfinite_count == 0
        && guard_mismatches == 0 && canary_mismatches == 0) {
      record.status = "pass";
      ++passed;
    } else {
      std::ostringstream reason;
      reason << "FP32 oracle/guard failure: out_abs<=" << abs_tolerance
             << " out_scaled_rel<=" << scaled_rel_tolerance
             << " inv_abs<=" << inv_abs_tolerance
             << " inv_scaled_rel<=" << inv_scaled_rel_tolerance;
      record.status = "fail";
      record.reason = reason.str();
      ++failed;
    }
    csv.Write(record);
    std::fprintf(
        stderr,
        "[%s] %s rows=%lld cols=%lld out_abs=%.3e out_rel=%.3e inv_abs=%.3e "
        "nonfinite=%llu guard=%llu canary=%llu\n",
        record.status.c_str(), record.variant.c_str(),
        static_cast<long long>(test_case.rows), static_cast<long long>(test_case.cols),
        max_abs_error, max_scaled_rel_error, max_inv_abs_error,
        static_cast<unsigned long long>(nonfinite_count),
        static_cast<unsigned long long>(guard_mismatches),
        static_cast<unsigned long long>(canary_mismatches));
  }

  std::fprintf(stderr, "rms_norm correctness: selected=%d pass=%d fail=%d skip=%d\n",
               selected, passed, failed, skipped);
  if (selected == 0 || passed == 0) { return 3; }
  return failed == 0 ? 0 : 2;
}
